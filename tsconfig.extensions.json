{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": []
  },
  "include": [
    "packages/*/index.ts",
    "packages/*/extensions/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/agent-teams/tests/tool-param-schema-fixture.ts",
    "packages/kit/tests/activity-row-fixture.ts",
    "packages/context/tests/context_widget_harness.mts"
  ]
}
