{
  "checks": [
    { "clause": 1, "op": "equals", "path": "workspace.plan", "value": "pro" }
  ],
  "triage": [
    { "id": "proration_wrong", "description": "the invoice covers a full period instead of the remaining days" },
    { "id": "duplicate_charge", "description": "the payment method was charged more than once" },
    { "id": "seat_loss", "description": "a seat the workspace had before the upgrade is no longer assigned" }
  ],
  "run": {
    "suite": "tests/billing/upgrade.e2e.ts",
    "steps": [
      { "api": "app.open", "label": "/settings/billing", "status": "passed" },
      { "api": "agent.act", "label": "upgrade the workspace to the Pro plan", "status": "passed" },
      { "api": "expect", "label": "getByRole('status') contains Pro", "status": "passed" }
    ],
    "observations": {
      "billing_page_text": "Plan: Pro. Next invoice 24 Apr 2026: USD 96.00 for the remaining 8 days of the current period. 12 seats.",
      "workspace": { "id": "acme-b2b", "plan": "pro", "seats_assigned": 12, "seats_total": 12 },
      "invoice": { "amount_usd": 96, "currency": "USD", "period": "2026-04-16..2026-04-30", "days": 8, "seat_count": 12 },
      "payment_events": [
        { "id": "ch_881", "kind": "charge", "status": "succeeded", "amount_usd": 96, "method": "card_4242" }
      ]
    }
  }
}
