FROM node:24-bookworm-slim
COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /usr/local/bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends python3 python-is-python3 ca-certificates curl unzip git && rm -rf /var/lib/apt/lists/*
RUN npm install -g bun@1.4.1
ENV PATH=/usr/local/bin:$PATH
WORKDIR /opt/study
COPY package.json ./
COPY packages/kit/package.json ./packages/kit/package.json
COPY packages/matt-pocock/package.json ./packages/matt-pocock/package.json
RUN --mount=type=cache,target=/root/.bun/install/cache bun add --dev --exact @earendil-works/pi-coding-agent@1.5.0 @earendil-works/pi-tui@1.5.0 tsx@4.23.12 typebox@1.3.12
RUN --mount=type=cache,target=/root/.bun/install/cache bun install
COPY packages ./packages
ENV PATH=/opt/study/node_modules/.bin:/root/.bun/bin:$PATH
RUN mkdir /work /results /agent && chown -R node:node /work /results /agent
USER node
WORKDIR /work
CMD ["sleep", "infinity"]
