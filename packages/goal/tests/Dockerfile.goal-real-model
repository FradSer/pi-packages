FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates curl unzip git && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL --retry 5 --retry-delay 2 --max-time 300 https://bun.sh/install -o /tmp/bun-install.sh \
  && BUN_INSTALL=/usr/local bash /tmp/bun-install.sh bun-v1.4.1
ENV PATH=/root/.bun/bin:$PATH
WORKDIR /opt/study
COPY package.json ./
COPY packages/kit/package.json ./packages/kit/package.json
COPY packages/goal/package.json ./packages/goal/package.json
RUN --mount=type=cache,target=/root/.bun/install/cache bun add --dev --exact @earendil-works/pi-coding-agent@1.3.0 @earendil-works/pi-ai@1.3.0 @earendil-works/pi-tui@1.3.0 tsx@4.23.12 typebox@1.3.27
RUN --mount=type=cache,target=/root/.bun/install/cache bun install
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip python3-venv \
  && python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir pytest pyte && rm -rf /var/lib/apt/lists/*
COPY packages ./packages
ENV PATH=/opt/study/node_modules/.bin:/opt/venv/bin:/root/.bun/bin:$PATH
RUN mkdir /work /results /agent && chown -R node:node /work /results /agent
USER node
WORKDIR /work
CMD ["sleep", "infinity"]
