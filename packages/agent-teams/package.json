{
  "name": "@fradser/pi-agent-teams",
  "version": "0.10.0",
  "description": "Agent-to-Agent communication for Pi \u2014 point-to-point messaging, notices, Agent Presence, and the Team Console. A bundle: it registers `message` and loads the pi-subagents and pi-tasks extensions, so installing it gives `agent` + `task` + `message` with one registrant per tool.",
  "keywords": [
    "pi-package",
    "teammates",
    "openai",
    "workspace-agents",
    "agents",
    "multi-agent",
    "team",
    "orchestration"
  ],
  "author": "Frad LEE <fradser@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FradSer/pi-packages.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "src",
    "references",
    ".memory",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts",
      "./node_modules/@fradser/pi-subagents/index.ts",
      "./node_modules/@fradser/pi-tasks/index.ts"
    ]
  },
  "dependencies": {
    "@fradser/pi-kit": "workspace:*",
    "@fradser/pi-subagents": "workspace:*",
    "@fradser/pi-tasks": "workspace:*"
  }
}
