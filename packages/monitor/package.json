  "description": "Result-contract background monitoring for Pi — capture noisy command output outside model context and expose one structured terminal result",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "monitor",
    "background",
    "watch",
    "logs",
    "observability",
    "streaming"
  ],
  "author": "Frad LEE <fradser@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FradSer/pi-packages.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "src",
    "references",
    "README.md"
  ],
  "dependencies": {
    "@fradser/pi-kit": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0"
  }
}
