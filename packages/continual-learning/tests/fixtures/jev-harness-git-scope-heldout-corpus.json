[
  {
    "id": "en-heldout-repository-wide-ban",
    "language": "en",
    "expectedAllow": true,
    "snapshot": {
      "contextEnabled": true,
      "entries": [
        {
          "role": "user",
          "content": "For all future work in this repository, never invoke git push with any arguments."
        }
      ]
    },
    "plan": {
      "kind": "harness-consolidation-plan",
      "operations": [
        {
          "op": "addRule",
          "rule": {
            "id": "fixed-no-push",
            "bash": "^git(?:[ \\t]+(?:-C[ \\t]+\\.|-c[ \\t]+core\\.quotePath=false|--no-pager))*[ \\t]+push(?:[ \\t]|$(?![\\s\\S]))",
            "action": "block",
            "message": "For all future work in this repository, never invoke git push with any arguments."
          },
          "cases": {
            "positive": [
              {
                "bash": "git push --dry-run",
                "expected": "block"
              },
              {
                "bash": "git -C . push --dry-run",
                "expected": "block"
              }
            ],
            "negative": [
              {
                "bash": "echo git -C . push --dry-run"
              },
              {
                "bash": "git status --short"
              }
            ]
          }
        }
      ],
      "evidence": [
        {
          "index": 0,
          "source": "user",
          "quote": "For all future work in this repository, never invoke git push with any arguments.",
          "count": 1
        }
      ]
    }
  },
