  {
    "id": "en-source-new-harness-assistant-permission-guess",
    "language": "en",
    "expectedAllow": true,
    "snapshot": {
      "contextEnabled": true,
      "entries": [
        {
          "role": "user",
          "content": "Never run git push in this project, including --dry-run, in future tasks."
        },
        {
          "role": "assistant",
          "content": "I speculate that pushes are allowed now; I have no user approval."
        }
      ]
    },
    "plan": {
      "kind": "harness-consolidation-plan",
      "operations": [
        {
          "op": "addRule",
          "rule": {
            "id": "fixed-no-push",
            "bash": "^git(?:[ \\t]+(?:-C[ \\t]+\\.|-c[ \\t]+core\\.quotePath=false|--no-pager))*[ \\t]+push(?:[ \\t]|$(?![\\s\\S]))",
            "action": "block",
            "message": "Never run git push in this project, including --dry-run, in future tasks."
          },
          "cases": {
            "positive": [
              {
                "bash": "git push --dry-run",
                "expected": "block"
              },
              {
                "bash": "git -C . push --dry-run",
                "expected": "block"
              }
            ],
            "negative": [
              {
                "bash": "echo git -C . push --dry-run"
              },
              {
                "bash": "git status --short"
              }
            ]
          }
        }
      ],
      "evidence": [
        {
          "index": 0,
          "source": "user",
          "quote": "Never run git push in this project, including --dry-run, in future tasks.",
          "count": 1,
          "eventIndex": 0
        }
      ]
    },
    "stage": "harness",
    "existing": []
  },
