  "description": "Run an artifact-driven SDLC with intent, design, plan, verification, review, release and metric feedback.",
  "type": "module",
  "keywords": [
    "pi-package",
    "sdlc",
    "intent",
    "handoff"
  ],
  "author": "Frad LEE <fradser@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
