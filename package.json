{
  "name": "fradser-pi-packages",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo of Frad's pi packages — skills and extensions published to npm and listed on pi.dev/packages",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test packages/impeccable/tests packages/open-deskos/tests packages/utils/tests/live-sessions*.test.ts packages/continual-learning/tests/*.test.ts packages/kit/tests/hidden-thinking.test.ts packages/context/tests/hidden-thinking.test.ts",
    "test:py": "uv run pytest tests",
    "check:install": "bun scripts/check-installation.mjs",
    "example:sdk": "bun examples/sdk-session.ts",
    "publish": "bun run check && bun scripts/publish-release.mjs",
    "publish:dry-run": "bun run pack:check",
    "typecheck": "bun x tsc --noEmit -p tsconfig.extensions.json",
    "check": "bun run test && bun run typecheck && bun run pack:check",
    "pack:check": "bun scripts/publish-release.mjs --check"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@changesets/cli": "^3.0.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^26.4.0",
    "tsx": "^4.19.0",
    "typebox": "^1.3.12",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "shell-quote": "^1.11.0",
    "source-map-js": "^1.2.2",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-codemode": "1.5.0",
    "@earendil-works/pi-mcp": "1.5.0",
    "@earendil-works/pi-telemetry": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0"
  },
  "trustedDependencies": [
    "esbuild",
    "@google/genai",
    "protobufjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "packageManager": "bun@1.4.1"
}
